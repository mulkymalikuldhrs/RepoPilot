{
  "name": "repopilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A frontend-first control plane for user-owned Git synchronization and repair workflows.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src vite.config.ts eslint.config.js scripts",
    "security:bundle": "node scripts/check-bundle-secrets.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"docs/**/*.md\" README.md \"*.json\" \"*.js\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"docs/**/*.md\" README.md \"*.json\" \"*.js\" \".github/**/*.yml\"",
    "check": "npm run lint && npm run test && npm run format:check"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^7.3.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
